# Server-only authenticated 1inch API key. Never expose this as NEXT_PUBLIC_*.
ONEINCH_API_KEY=

# Base Mainnet RPC used by deployment scripts and server-side reads.
BASE_MAINNET_RPC_URL=https://base.publicnode.com
NEXT_PUBLIC_BASE_RPC_URL=https://base.publicnode.com

# Dedicated deployment wallet key. Local ignored env only; never commit or print it.
DEPLOYER_PRIVATE_KEY=

# Verified deployment outputs. These are public addresses, not secrets.
NEXT_PUBLIC_ENKRATE_ASSET_REGISTRY=
NEXT_PUBLIC_ENKRATE_EXECUTION_ENGINE=
NEXT_PUBLIC_ENKRATE_DEPLOYMENT_BLOCK=