# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# temporary Phase 0B Foundry outputs
/fork-harness/out/
/fork-harness/cache/

# production Foundry outputs and local test logs
/contracts/out/
/contracts/cache/
/contracts/*.log
/contracts/*.pid

# Local deployment outputs are never committed during preparation.
/deployments/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local secrets
.env
.env.local

# Generated / local tooling
.next/
node_modules/
.playwright-cli/
output/
audit/
agent-state/
NUL
